# Copy to /etc/wildfire-daily.env (or source before manual runs) and fill in
# machine-specific paths. Do not commit real credentials or inaccessible paths.
WILDFIRE_DATA_ROOT=/path/to/wildfire-data
FIREMPC_ROOT=/home/quinn/FireMPC
FIREMPC_PYTHON=/path/to/conda/envs/gee_down/bin/python
WILDFIRE_GRID_TEMPLATE=/path/to/national_grid.tif
WILDFIRE_CANADA_GRIDS_SHP=/path/to/Canada_Export_grids_1_2.shp
WILDFIRE_STATIC_OSM=/path/to/OSM_2025.tif
WILDFIRE_STATIC_WORLDPOP=/path/to/globalpop_2025.tif
WILDFIRE_STATIC_TERRAIN=/path/to/DEMs_2000.tif
WILDFIRE_EARTH_ENGINE_PROJECT=your-earth-engine-project
WILDFIRE_ASSET_RELEASE=operational-v1
