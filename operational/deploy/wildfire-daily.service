[Unit]
Description=CanFireCast daily operational run
Documentation=file:///home/quinn/FireMPC/operational/deploy/README.md
# Every stage downloads from GEE or Earthdata; without this the timer fires
# into a dead network on boot and burns its retries.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=quinn
Group=quinn
WorkingDirectory=/home/quinn/FireMPC
Environment=PATH=/home/quinn/.conda/envs/gee_down/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/quinn/FireMPC/operational/src
EnvironmentFile=/etc/wildfire-daily.env
ExecStart=/home/quinn/.conda/envs/gee_down/bin/python -m wildfire.daily --target today
# A full cold run is hours of downloads; only kill a genuinely wedged one.
TimeoutStartSec=8h
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
